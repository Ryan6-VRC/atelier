# Ignored siblings, not tracked here: the vrc-* tool repos are versioned separately (their
# own git repos); AvatarProject is an untracked working venue (see CLAUDE.md §Layout).
/AvatarProject/
/vrc-blender-tools/
/vrc-skills/
/vrc-bridge/
/vrc-unity-tools/
/vrc-patterns/
/vrc-mcp-proxy/

# Temporary files the user is providing for context or to help understand a task
/docs/samples/

# Brainstorming/design specs — local working artifacts, not workspace docs
/docs/superpowers/

# Fitting-session assay records (ledger + run reports) — machine-local, like the vendor library they index
/docs/assay/

# Reference clones are reproducible from references/README.md; track only the routing doc
/references/*
!/references/README.md

# Curated showcase runs (showcase-record keepers) — local media only, like docs/assay/
/showcases/

# Python bytecode (from tools/)
__pycache__/
*.pyc

# OS / editor junk
Thumbs.db
desktop.ini
.DS_Store
*.code-workspace

# Personal/machine-specific setup (machine-specific MCP servers register at
# local scope — bootstrap.md; the tracked .mcp.json carries only universal ones)
CLAUDE.local.md

# Internal working scratch — not for the public repo (kept locally, untracked)
kickoffs.md
fixups.md
*-staleness-repro.md

# Local, script-generated headless test projects (tools/setup-test-editor.ps1) — never committed.
# The glob covers per-session suffixed editors (TestEditor-<name>) run from worktrees.
/TestEditor*/
# Disposable run-output (tools/run-editmode-tests.ps1 writes results-*.xml + run-*.log here and
# self-prunes at 30 days). Sits beside TestEditor rather than in tools/ so tooling dirs hold only
# tooling: the same files under a narrower in-place ignore reached 457 MB unseen.
/test-output/
